# AI News Radar — supported environment variables.
# Reference only: the application reads variables from the process environment
# and does not automatically load a .env file. Do not commit local credentials.

# User-Agent sent with outbound requests. SEC EDGAR expects a descriptive
# agent that includes a contact address. Set a real contact before heavy use.
AI_NEWS_RADAR_USER_AGENT=ai-news-radar/0.2 research-tool contact=you@example.com

# Log verbosity: DEBUG / INFO / WARNING / ERROR.
AI_NEWS_RADAR_LOG_LEVEL=INFO

# Required only when binding the web server to a non-localhost interface.
# Keep this secret and set it in the service environment, not in source control.
# AI_NEWS_RADAR_PASSWORD=
# AI_NEWS_RADAR_USER=admin

# Not wired yet: the EIA source is skipped until key-based fetching is implemented.
# EIA_API_KEY=

# Not wired yet: unusual-options-flow ingestion is not connected to a real feed.
# OPTIONS_FLOW_API_KEY=
